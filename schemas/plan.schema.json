{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionPlan",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "goal": { "type": "string" },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool"],
        "properties": {
          "id": { "type": "string" },
          "step": { "type": "integer", "minimum": 1 },
          "tool": { "type": "string", "minLength": 1 },
          "params": { "type": "object" },
          "args": { "type": "object" },
          "description": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          },
          "check": {
            "type": "object",
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "expect_contains": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "on_fail": {
            "type": "object",
            "properties": {
              "retry": { "type": "integer", "minimum": 0, "maximum": 5 },
              "strategy": {
                "type": "string",
                "enum": ["retry_same", "revise_args"]
              }
            }
          }
        }
      }
    }
  }
}
